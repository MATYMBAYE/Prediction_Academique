# Copier ce fichier en ".env" et adapter les valeurs a votre environnement XAMPP

# Base de donnees MySQL (XAMPP)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=Prediction_db

# Securite
JWT_SECRET_KEY=change-moi-en-production
SECRET_KEY=change-moi-en-production

# Seuils de risque (probabilite de reussite en dessous desquels le risque augmente)
SEUIL_RISQUE_ELEVE=0.45
SEUIL_RISQUE_MOYEN=0.65

# CORS
FRONTEND_ORIGIN=http://localhost:5173

# Configuration E-mail et SMTP (ISI-SUPTECH)
INSTITUTIONAL_EMAIL_DOMAIN=groupeisi.com
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=matymbayeisidp@groupeisi.com
MAIL_PASSWORD=votre_mot_de_passe_ou_cle_d_application
MAIL_DEFAULT_SENDER_ADDR=matymbayeisidp@groupeisi.com
MAIL_DEFAULT_SENDER_NAME=ISI-SUPTECH
